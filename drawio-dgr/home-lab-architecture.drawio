  <diagram name="2. Cluster / namespace view" id="cluster-view">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="Cluster / Namespace View — homelab + k3os-local" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="290" y="20" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="homelab" value="kubeconfig context: homelab&#xa;k8s 1.36.1 — 3 masters + 3 workers&#xa;CNI: Calico v3.30.4 (pod CIDR 10.0.0.0/16)&#xa;Mesh: Istio 1.27.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="hl-kube" value="kube-system&#xa;kube-apiserver / scheduler / controller-manager (×3 each)&#xa;coredns • kube-proxy DS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hl-calico" value="calico-system / calico-apiserver / tigera-operator&#xa;calico-node DS • calico-typha • calico-kube-controllers&#xa;BGP TCP/179 + VXLAN UDP/4789 between nodes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="195" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hl-istio" value="istio-system&#xa;istiod • istio-ingressgateway (Service LoadBalancer pending)&#xa;Sidecar injection enabled on default namespace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hl-mon" value="monitoring&#xa;kube-prometheus-stack (Prometheus only — no Grafana/AM here)&#xa;remote_write → gdragon:30320 with cluster=homelab&#xa;Promtail DS (6 nodes) → gdragon:30310" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="355" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hl-extern" value="Externally exposed&#xa;kube-apiserver via HAProxy VIP   https://192.168.1.50:6443&#xa;dnsmasq via same VIP            udp/tcp :53&#xa;HTTP/HTTPS ingress (planned)    VIP :80/:443 → kworker NodePorts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hl-status" value="Status (2026-05-18): all 6 nodes Ready, calico healthy, APIService True." style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k3os" value="kubeconfig context: k3os-local&#xa;k3s 1.34.3 — single node (gdragon, .181)&#xa;CNI: Calico (IPPool 192.168.0.0/16 ⚠ overlaps LAN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="510" height="700" as="geometry" />
        </mxCell>
        <mxCell id="k-kube" value="kube-system&#xa;k3s collapses cp/sched/cm/proxy/etcd into one binary&#xa;traefik (default ingress) — currently unused" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k-mon" value="monitoring&#xa;Grafana :30300 (admin / changeme-home-lab)&#xa;Prometheus :30320 (remote_write receiver from homelab)&#xa;Loki :30310 (push API)  •  Alertmanager  •  KSM  •  node-exporter  •  Promtail DS&#xa;sub-path mode enabled (root_url=/grafana/, routePrefix=/prometheus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="195" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k-vault" value="vault   (Helm 0.31.0, image hashicorp/vault:1.20.4)&#xa;3-replica StatefulSet, raft storage&#xa;Services:  vault :30200 (any)  •  vault-active :31326 (leader)&#xa;Liveness probe path: ?standbyok=true&amp;sealedcode=204&amp;uninitcode=204&#xa;Vault-0 unsealed LEADER • Vault-2 joined • Vault-1 CLBO (IPPool)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="320" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="k-argo" value="argocd&#xa;argocd-server :30401 (http) / :30400 (https)&#xa;rootpath = /argocd (in argocd-cmd-params-cm)&#xa;Reconciles: vault Application + app-of-apps (manifests in this git repo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="455" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k-calico" value="calico-system / calico-apiserver / tigera-operator&#xa;IPPool 192.168.0.0/16 — overlap workaround:&#xa;systemd unit k3s-pod-masq.service masquerades pod→external" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k-storage" value="storage: local-path PVC provisioner (k3s default)&#xa;PVCs live on hot-added 100GiB → /var (xfs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="655" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="Cross-cluster link&#xa;homelab → k3os-local for metrics &amp; logs&#xa;(see &quot;3. Monitoring data flow&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
