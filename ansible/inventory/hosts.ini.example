# Copy to hosts.ini and fill in IPs. clone-from-vault.sh writes one of these
# automatically using DHCP-assigned addresses; otherwise fill in manually.
#
# HA LB pair: lb1 is MASTER (priority 101), lb2 is BACKUP (priority 100).
# Both run HAProxy + keepalived + dnsmasq. The keepalived VIP `vip:` in
# group_vars/all/vars.yml (default 192.168.1.50) is owned by whichever is
# alive with highest priority.

[k8s_masters]
kmaster1 ansible_host=192.168.1.x
kmaster2 ansible_host=192.168.1.x
kmaster3 ansible_host=192.168.1.x

[k8s_workers]
kworker1 ansible_host=192.168.1.x
kworker2 ansible_host=192.168.1.x
kworker3 ansible_host=192.168.1.x

[loadbalancers]
lb1 ansible_host=192.168.1.x keepalived_state=MASTER keepalived_priority=101
lb2 ansible_host=192.168.1.x keepalived_state=BACKUP keepalived_priority=100

[vault]
vault-server ansible_host=192.168.1.x

[cluster:children]
k8s_masters
k8s_workers
loadbalancers

[everyone:children]
cluster
vault

[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=/apps/git-code/keys/ansible-key
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
