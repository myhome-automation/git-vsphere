# Auto-recovery on every boot of gdragon (the lab is shut down nightly).
# Install on gdragon:
#   sudo cp scripts/platform-startup.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable platform-startup.service
# Logs: /var/log/platform-startup.log  (or: journalctl -u platform-startup)
[Unit]
Description=Home-lab platform startup (power on cluster, unseal transit Vault, converge)
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
User=bstha
Group=bstha
# Let the network, k3s, and (if co-booting) the ESXi host settle first.
ExecStartPre=/bin/sleep 90
ExecStart=/apps/git-code/git-vsphere/scripts/platform-startup.sh
StandardOutput=append:/var/log/platform-startup.log
StandardError=append:/var/log/platform-startup.log
TimeoutStartSec=2400
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
